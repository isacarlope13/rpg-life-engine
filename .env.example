# ============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - RPG LIFE-ENGINE (RAILWAY & SUPABASE)
# ============================================================================
# Copia estas variables en la pestaña "Variables" de tu proyecto en Railway
# o en tu archivo .env.local para desarrollo local.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. SUPABASE (Base de datos PostgreSQL en la nube, Autenticación y Realtime)
# ----------------------------------------------------------------------------
# Encuéntralas en: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key
# Obligatoria para aprovisionamiento seguro de perfiles y bypass de RLS en el backend:
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-secret-key

# ----------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI (Activa las 8 AI Skills del RPG Life-Engine)
# ----------------------------------------------------------------------------
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey
# Utilizada para:
# - Desglose y escaneo de facturas/recibos (Receipt Scanner)
# - Auditoría y estructuración de proyectos ágiles (Scrum, Kanban, Lean)
# - Extracción determinista de especificaciones de libros y cubos de Rubik
# - Onboarding inteligente y generación dinámica de clases de aventurero
# - Gamemaster Daily Briefings
GEMINI_API_KEY=tu-gemini-api-key

# ----------------------------------------------------------------------------
# 3. ATRIBUTOS DE SEGURIDAD & APPLE / SIRI SHORTCUTS
# ----------------------------------------------------------------------------
# Token secreto para autorizar peticiones desde iOS Atajos (x-api-key)
SHORTCUTS_API_SECRET=crea-un-token-seguro-aqui

# (Opcional) UUID del usuario principal si envías atajos móviles de un solo usuario:
# DEFAULT_PLAYER_USER_ID=00000000-0000-0000-0000-000000000000

# ----------------------------------------------------------------------------
# 4. SPOTIFY INTEGRATION UI (AUDIO HUB EN EL SANTUARIO) - OPCIONAL
# ----------------------------------------------------------------------------
# Permite mostrar en vivo el audiolibro, podcast o música de enfoque en el Santuario.
# Si no se configuran, el sistema opera con fallback inteligente sin errores.
# Obténlas en: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=tu-spotify-client-id
SPOTIFY_CLIENT_SECRET=tu-spotify-client-secret
SPOTIFY_REFRESH_TOKEN=tu-spotify-refresh-token

# ----------------------------------------------------------------------------
# 5. ENTORNO DE PRODUCCIÓN
# ----------------------------------------------------------------------------
NODE_ENV=production
